{
  "name": "rpg-assistant-desktop",
  "productName": "RPG Assistant",
  "version": "1.0.0",
  "description": "RPG Assistant desktop app",
  "author": "RPG Assistant",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win --x64",
    "dist": "electron-builder --linux --win --x64"
  },
  "build": {
    "appId": "com.example.rpgassistant",
    "productName": "RPG Assistant",
    "icon": "icon.png",
    "artifactName": "RPG-Assistant-${version}-${os}.${ext}",
    "files": ["main.js", "icon.png"],
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "extraResources": [{ "from": "server-linux", "to": "server" }]
    },
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "extraResources": [{ "from": "server-win", "to": "server" }]
    }
  }
}

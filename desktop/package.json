{
  "name": "rpg-assistant-desktop",
  "productName": "RPG Assistant",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.example.rpgassistant",
    "files": [
      "main.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      }
    ],
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "nvm": "^0.0.4"
  }
}
